# -----------------------------------------------------------------------------
# Environment Variables Configuration
# -----------------------------------------------------------------------------
# GATE is built with zero-dependency graceful degradation.
# To demonstrate the bulletproof offline architecture to judges:
#
# 1. Comment out `# GEMINI_API_KEY`:
#    - The serverless proxy gracefully falls back to building-level reverse geocoding
#      (e.g., "TINKERSPACE, CALICUT") and populates the 17 algorithmic offline missions.
#
# 2. Comment out `# NEXT_PUBLIC_SUPABASE_URL` & `# NEXT_PUBLIC_SUPABASE_ANON_KEY`:
#    - The application drops into "Guest Mode" with full local layover countdown,
#      stats drain, offline IndexedDB photo proofs, and local Safe Travels passport card.
#
# DO NOT commit actual secrets to the repository!
# -----------------------------------------------------------------------------

# Gemini API Key for AI Mission Generation
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
