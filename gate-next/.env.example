# -----------------------------------------------------------------------------
# GATE — Environment Variables (.env.local)
# -----------------------------------------------------------------------------
# All variables are feature-detected with zero-dependency graceful degradation:
# - Missing GROQ_API_KEY: App runs offline on 17 static algorithmic fallback missions.
# - Missing SUPABASE keys: App automatically drops into local Guest Mode.
# -----------------------------------------------------------------------------

# Groq API key for single background venue mission generation (server-side only)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model identifier for venue mission generation (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API key for fallback reverse geocode mission proxy (server-side only)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Supabase project URL for authentication and multi-session persistence (client & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous public API key with Row Level Security (client & server)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
